# Copy to .env and fill in. Leave everything empty to run the on-device demo.
# Step-by-step guide: docs/GO_LIVE.md
#
# These are all safe to ship in the app. Secret keys (Stripe secret key,
# Supabase service-role key, webhook secrets) never go here: they are
# Supabase function secrets.

# Supabase → Project Settings → API. Turns on sign-in, shared data and push.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Stripe → Developers → API keys (pk_test_... while testing). Turns on card payments.
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Optional: Apple Pay merchant id (merchant.com.yourcompany.manna). Also set it in app.json.
EXPO_PUBLIC_APPLE_MERCHANT_ID=
