{
  "expo": {
    "name": "Manna",
    "slug": "manna",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "manna",
    "userInterfaceStyle": "dark",
    "ios": {
      "bundleIdentifier": "com.mannaapp.manna",
      "supportsTablet": false,
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Manna uses your photos so you can add pictures of your kitchen and your food.",
        "NSPhotoLibraryAddUsageDescription": "Manna saves your Instagram Story card to your photos when you choose Save Image."
      },
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.mannaapp.manna",
      "blockedPermissions": [
        "android.permission.READ_CALENDAR",
        "android.permission.WRITE_CALENDAR"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0B0B0B",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Manna uses your photos so you can add pictures of your kitchen and your food."
        }
      ],
      "expo-font",
      "expo-sharing",
      [
        "expo-calendar",
        {
          "writeOnlyAccess": true,
          "writeOnlyCalendarPermission": "Manna adds your pickup time to your calendar when you ask it to. It can't see your other events.",
          "calendarPermission": "Manna adds your pickup time to your calendar when you ask it to.",
          "remindersPermission": false
        }
      ],
      "expo-video",
      [
        "@stripe/stripe-react-native",
        {
          "merchantIdentifier": "",
          "enableGooglePay": true
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/android-icon-monochrome.png",
          "color": "#D4B26E"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "backgroundColor": "#0B0B0B"
  }
}
